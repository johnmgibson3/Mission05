@{
      ViewData["Title"] = "Tutoring Calculator";
}

<div class="calculator-container">
      <h1>Calculate Lesson Costs</h1>

      <label for="hours">Enter Hours:</label>
      <input type="number" id="hours" min="1" placeholder="Enter number of hours" required>

      <label for="rate">Hourly Rate ($):</label>
      <input type="text" id="rate" value="20" readonly>

      <button class="btn" id="calculate">Calculate Total</button>

      <label for="total">Total Cost ($):</label>
      <input type="text" id="total" readonly>
</div>
